cuda_cflags = -I/home/weiyahui/projects/Monkey_Surface/test/test_tissue_guide_reg/FireANTs-main/fused_ops/include -I/home/weiyahui/software/anaconda3/envs/dio/include -I/home/weiyahui/software/anaconda3/envs/dio/include/torch/csrc/api/include -I/home/weiyahui/software/anaconda3/envs/dio/lib/python3.10/site-packages/torch/include -I/home/weiyahui/software/anaconda3/envs/dio/include -I/home/weiyahui/software/anaconda3/envs/dio/include/torch/csrc/api/include -I/home/weiyahui/software/anaconda3/envs/dio/lib/python3.10/site-packages/torch/include -I/home/soft/cuda-12.9/include -I/home/weiyahui/software/anaconda3/envs/dio/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -lineinfo -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="system"' '-DPYBIND11_STDLIB=""' '-DPYBIND11_BUILD_ABI="_libstdcpp_gxx_abi_1xxx_use_cxx11_abi_1"' -DTORCH_EXTENSION_NAME=fireants_fused_ops -D_GLIBCXX_USE_CXX11_ABI=1 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -ccbin /home/weiyahui/software/anaconda3/envs/dio/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







